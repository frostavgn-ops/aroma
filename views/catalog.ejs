<%- include('partials/top', { title: 'Каталог — AROMA', active: 'catalog' }) %>

  <main>
    <h1 class="page-title">Каталог</h1>

    <div class="filters">
      <strong>Фильтры:</strong>
      <button class="btn on" data-filter="all">Все</button>
      <button class="btn" data-filter="m">Мужские</button>
      <button class="btn" data-filter="w">Женские</button>
      <div class="price-box">
        Цена: от <input type="number" id="priceFrom" placeholder="0">
        до <input type="number" id="priceTo" placeholder="10000">
        <button class="btn btn-fill" id="applyPrice">Применить</button>
      </div>
    </div>

    <div class="cards" id="catalogCards">
      <% products.forEach(p => { %>
        <%- include('partials/card', { p }) %>
      <% }) %>
    </div>

    <div class="pagination"><span>&lsaquo;</span><span class="on">1</span><span>2</span><span>3</span><span>&rsaquo;</span></div>
  </main>

<%- include('partials/bottom') %>